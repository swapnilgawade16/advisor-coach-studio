{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "None",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ai": {
    "Mode": "Unconfigured"
  },
  "AccessGate": {
    "SharedCode": "",
    "CodeVersion": "1",
    "CookieHours": 8
  },
  "AzureRealtime": {
    "Endpoint": "",
    "Deployment": "",
    "Authentication": null,
    "ApiKey": "",
    "TranscriptionModel": "",
    "Voice": "",
    "TokenScope": "https://ai.azure.com/.default",
    "ConnectTimeoutSeconds": 15
  },
  "AzureReports": {
    "Endpoint": "",
    "Deployment": "",
    "Authentication": null,
    "ApiKey": "",
    "TokenScope": "https://ai.azure.com/.default",
    "TimeoutSeconds": 60,
    "MaxAttempts": 3,
    "MaxOutputTokens": 4000,
    "ReasoningEffort": ""
  },
  "Realtime": {
    "MaxSessionMinutes": 2,
    "MaxConcurrentSessions": 5,
    "VadThreshold": 0.5,
    "VadPrefixPaddingMs": 300,
    "VadSilenceDurationMs": 500,
    "FinalizationDrainSeconds": 5,
    "MaxQueuedInputMs": 1000,
    "MaxQueuedOutputMs": 2000,
    "MaxBufferedResponseSeconds": 60,
    "DemonstrationMaxSeconds": 90,
    "UnstartedSessionMinutes": 10
  },
  "Demonstration": {
    "Enabled": true
  },
  "Security": {
    "AllowedOrigins": [],
    "UseForwardedHeaders": false,
    "KnownProxies": []
  }
}
