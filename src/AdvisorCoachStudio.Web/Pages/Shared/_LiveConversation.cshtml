@model LiveConversationModel
<section id="live" class="card live" hidden aria-labelledby="live-heading"
         data-max-seconds="@Model.MaxSeconds" data-client-name="@Model.ClientDisplayName">
    <div class="live-header">
        <div>
            <h2 id="live-heading" tabindex="-1">@Model.ScenarioTitle</h2>
            <div class="client-row">
                <span class="avatar" aria-hidden="true">@Model.ClientInitials</span>
                <span>@Model.ClientDisplayName <span class="hint">(fictional client)</span></span>
            </div>
        </div>
        <div class="live-meta">
            <p><span class="label">Elapsed</span> <span id="live-elapsed" class="timer">0:00</span> <span class="hint">of <span id="live-max">@($"{Model.MaxSeconds / 60}:{Model.MaxSeconds % 60:00}")</span></span></p>
            <div class="timer-bar" aria-hidden="true"><span></span></div>
            <p><span class="label">Difficulty</span> <span id="live-difficulty">@Model.Difficulty</span></p>
        </div>
    </div>

    <div class="state-panel">
        <div class="presence" aria-hidden="true"><span class="avatar">@Model.ClientInitials</span></div>
        <p id="live-state" class="state" data-state="connecting">Connecting&hellip;</p>
        <div id="live-activity" class="activity" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
        <p id="live-announcer" class="visually-hidden" aria-live="polite" aria-atomic="true"></p>
        <p id="live-network" class="hint warning-text" role="status" hidden></p>
    </div>

    <div class="controls">
        <button id="mute-button" type="button" class="button secondary" aria-pressed="false" disabled>Mute microphone</button>
        <button id="end-button" type="button" class="button danger" disabled>End session</button>
    </div>

    <div id="live-error" class="alert alert-error" role="alert" hidden></div>

    <div id="ended-panel" class="ended-panel" hidden>
        <p id="ended-text"></p>
        <div class="button-row">
            <a id="report-link" class="button primary" href="#">View coaching report</a>
            <a class="button secondary" href="/">Choose another scenario</a>
        </div>
    </div>

    <details id="transcript-panel" class="transcript-panel">
        <summary>Live transcript</summary>
        <p class="hint">Transcripts are generated by speech recognition and may contain errors. Provisional text is shown in italics until it is final.</p>
        <ol id="transcript-list" class="transcript" aria-label="Conversation transcript"></ol>
        <p id="transcript-empty" class="hint">No transcript yet.</p>
    </details>

    <p class="privacy-reminder">Fictional simulation: do not share real client information. Audio is streamed to Azure AI and is not stored by this application. Use headphones to avoid echo.</p>
</section>
