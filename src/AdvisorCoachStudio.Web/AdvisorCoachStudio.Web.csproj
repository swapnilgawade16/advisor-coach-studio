<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AdvisorCoachStudio.Web</RootNamespace>
    <AssemblyName>AdvisorCoachStudio.Web</AssemblyName>
    <UserSecretsId>advisor-coach-studio-local</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Scenarios\**\*.json;Schemas\**\*.json;Prompts\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <None Update="Prompts\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdvisorCoachStudio.UnitTests" />
    <InternalsVisibleTo Include="AdvisorCoachStudio.IntegrationTests" />
    <InternalsVisibleTo Include="AdvisorCoachStudio.BrowserTests" />
  </ItemGroup>

</Project>
