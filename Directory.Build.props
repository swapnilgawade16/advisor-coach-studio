<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- CA1515 (make types internal) and CA1848/CA1873 (LoggerMessage delegates) are noisy for an application project. -->
    <!-- NU1507: machines with several NuGet feeds warn under central package management; feed choice is a local concern. -->
    <NoWarn>$(NoWarn);NU1507;CA1001;CA1515;CA1848;CA1873;CA2007;CA1031;CA1062;CA1716;CA1819;CA1305;CA1307;CA1310;CA1309;CA1002;CA1056;CA1054;CA1055;CA1711;CA1720;CA1724;CA1034;CA1508;CA1812;CA2000;CA1859;CA1822;CA1850;CA1861;CA1869;CA2234;CA1303;CA5394</NoWarn>
  </PropertyGroup>
</Project>
